# =============================================================================
# Fagan Inspection Tool - Environment Variables
# =============================================================================
# Kopiere diese Datei nach .env und fülle die Werte aus:
#   cp .env.example .env
#
# WICHTIG: .env niemals committen! (ist in .gitignore)
# =============================================================================

# OpenAI API Key (erforderlich für echte Runs)
OPENAI_API_KEY=sk-...

# Optional: Standard-Modell überschreiben (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o

# Optional: Anthropic API Key (falls Anthropic-Provider genutzt wird)
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: Debug-Modus für Matching (erzeugt match_debug.jsonl)
# FAGAN_MATCH_DEBUG=1
